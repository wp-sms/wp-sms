{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wsms/subscription-form",
  "version": "1.0.0",
  "title": "WSMS Subscription Form",
  "category": "widgets",
  "icon": "clipboard",
  "description": "Display a subscription form to collect email and phone contacts.",
  "textdomain": "wp-sms",
  "keywords": [
    "subscribe",
    "newsletter",
    "signup",
    "contact",
    "email",
    "phone",
    "opt-in"
  ],
  "attributes": {
    "formSlug": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js"
}