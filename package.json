{
  "name": "wp-sms",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vendor && concurrently \"npm run dev:dashboard\" \"npm run dev:scripts\" \"npm run dev:sass\" \"npm run dev:auth\" \"npm run dev:messaging-button\" \"npm run dev:subscription-form\" \"npm run dev:cf7-phone\" \"npm run dev:blocks\"",
    "dev:blocks": "wp-scripts start --config webpack.config.cjs --webpack-src-dir=resources/blocks --output-path=public/blocks",
    "dev:dashboard": "vite",
    "dev:scripts": "ENTRY=admin vite build -c vite.config.entries.mjs --watch",
    "dev:sass": "sass --watch resources/scss/admin.scss:public/css/admin.css resources/scss/frontend.scss:public/css/frontend.css",
    "dev:auth": "vite build -c vite.config.auth.mjs --watch",
    "dev:messaging-button": "vite build -c vite.config.messaging-button.mjs --watch",
    "dev:subscription-form": "vite build -c vite.config.subscription-form.mjs --watch",
    "dev:cf7-phone": "vite build -c vite.config.cf7-phone.mjs --watch",
    "build": "npm run build:dashboard && npm run build:scripts && npm run build:sass && npm run build:blocks && rm -rf public/auth && npm run build:vendor && npm run build:auth && npm run build:verify-widget && npm run build:messaging-button && npm run build:user-button && npm run build:subscription-form && npm run build:cf7-phone",
    "build:dashboard": "vite build",
    "build:scripts": "ENTRY=admin vite build -c vite.config.entries.mjs",
    "build:sass": "sass resources/scss/admin.scss:public/css/admin.css resources/scss/frontend.scss:public/css/frontend.css --style=compressed --no-source-map",
    "build:blocks": "wp-scripts build --config webpack.config.cjs --webpack-src-dir=resources/blocks --output-path=public/blocks",
    "build:vendor": "vite build --config vite.config.vendor.mjs",
    "dev:vendor": "vite build --config vite.config.vendor.mjs",
    "build:auth": "vite build -c vite.config.auth.mjs",
    "build:verify-widget": "vite build -c vite.config.verify-widget.mjs",
    "build:messaging-button": "vite build -c vite.config.messaging-button.mjs",
    "build:user-button": "vite build -c vite.config.user-button.mjs",
    "build:subscription-form": "vite build -c vite.config.subscription-form.mjs",
    "build:cf7-phone": "vite build -c vite.config.cf7-phone.mjs",
    "build:pot": "php -d error_reporting=E_ERROR -d memory_limit=512M $(which wp) i18n make-pot . public/languages/wp-sms.pot --slug=wp-sms --domain=wp-sms --skip-audit --exclude=node_modules,vendor,.git,resources",
    "build:json": "wp i18n make-json public/languages/ --no-purge",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "pa11y-ci --config .pa11yci",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.e2e.ts",
    "lint": "eslint resources/",
    "lint:fix": "eslint resources/ --fix"
  },
  "dependencies": {
    "@preact/signals": "^2.8.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@wordpress/i18n": "^6.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "lite-phone-input": "^0.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "preact": "^10.28.4",
    "preact-iso": "^2.11.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@wordpress/scripts": "^31.7.0",
    "ajv": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "msw": "^2.12.13",
    "otpauth": "^9.5.0",
    "pa11y-ci": "^4.1.0",
    "react-refresh": "^0.18.0",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  }
}
